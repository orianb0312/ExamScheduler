QMainWindow,
QDialog,
QWidget {
    background: #1f2024;
    color: #f1f3f5;
    font-size: 13px;
}

QLabel {
    color: #f1f3f5;
    background: transparent;
}

QLabel#screenTitle {
    font-size: 24px;
    font-weight: 600;
    color: #ffffff;
}

QLabel#pageSubtitleLabel {
    font-size: 14px;
    color: #c6ccd5;
}

QLabel#sectionTitle,
QLabel#sectionTitleLabel {
    font-size: 14px;
    font-weight: 600;
    color: #f1f3f5;
}

QLabel#error_label,
QLabel#programSelectionMessage {
    color: #d8e6ff;
    background: #26344f;
    border: 1px solid #496896;
    border-radius: 4px;
    padding: 8px 10px;
}

QLabel#paneTitle,
QLabel#programSelectionCount,
QLabel#calendarDayStatusLabel {
    font-weight: 600;
    color: #d7dce2;
}

QLabel#programSelectionCount {
    color: #7ed3ff;
    background: #2a405a;
    border: 1px solid #4c779c;
    border-radius: 12px;
    padding: 4px 12px;
}

QWidget#fileSourceSection {
    background: transparent;
    border-top: 1px solid #394456;
    padding-top: 10px;
}

QLabel#fileSourceTitle {
    color: #bfc8d6;
    font-size: 12px;
    font-weight: 700;
}

QLineEdit,
QComboBox,
QDateEdit {
    background: #2b2d33;
    color: #f1f3f5;
    border: 1px solid #5c626d;
    border-radius: 3px;
    padding: 5px 8px;
    selection-background-color: #4f8cff;
    selection-color: #ffffff;
}

QLineEdit:focus,
QComboBox:focus,
QDateEdit:focus {
    border-color: #72a7ff;
}

QComboBox QAbstractItemView {
    background: #2b2d33;
    color: #f1f3f5;
    border: 1px solid #5c626d;
    selection-background-color: #3d5f93;
    selection-color: #ffffff;
}

QCalendarWidget QWidget {
    background: #2b2d33;
    color: #f1f3f5;
}

QCalendarWidget QToolButton {
    background: #363941;
    color: #f1f3f5;
    border: 1px solid #5c626d;
}

QCalendarWidget QMenu {
    background: #2b2d33;
    color: #f1f3f5;
}

QCalendarWidget QSpinBox {
    background: #2b2d33;
    color: #f1f3f5;
    border: 1px solid #5c626d;
}

/* Student note: tables need their own colors because Qt may use OS defaults. */
QTableWidget {
    background: #25272d;
    color: #f1f3f5;
    gridline-color: #484d57;
    alternate-background-color: #2d3037;
    selection-background-color: #3d5f93;
    selection-color: #ffffff;
}

QTableWidget::item {
    color: #f1f3f5;
}

QHeaderView::section {
    background: #343740;
    color: #f1f3f5;
    border: 1px solid #4b505b;
    padding: 5px 8px;
    font-weight: 600;
}

QListWidget#programSelector {
    background: #25272d;
    color: #f1f3f5;
    border: 1px solid #4b505b;
    border-radius: 4px;
    padding: 8px;
}

QListWidget#programSelector::item {
    color: #f1f3f5;
    padding: 7px 8px;
}

QListWidget#programSelector::item:hover {
    background: #343740;
}

QListWidget#programSelector::item:selected {
    background: #3d5f93;
    color: #ffffff;
}

QListWidget#programSelector::indicator {
    width: 16px;
    height: 16px;
}

QPushButton#sortOptionsButton {
    background: #26344f;
    color: #d8e6ff;
    border: 1px solid #5b82ba;
    border-radius: 14px;
    padding: 6px 14px;
    font-weight: 700;
}

QPushButton#sortOptionsButton:hover {
    background: #304260;
    color: #ffffff;
}

QWidget#sortOptionsPanel {
    background: #171a21;
    border-left: 1px solid #465268;
}

QLabel#sortPanelTitle {
    color: #ffffff;
    font-size: 20px;
    font-weight: 700;
}

QLabel#sortPanelSubtitle {
    color: #aeb8c7;
    font-size: 12px;
}

QLabel#sortPriorityBadge {
    color: #d8e6ff;
    background: #2f6feb;
    border: 1px solid #6da6ff;
    border-radius: 12px;
    padding: 4px 10px;
    font-size: 11px;
    font-weight: 700;
}

QPushButton#sortResetButton {
    background: #252b36;
    color: #f1f3f5;
    border: 1px solid #596579;
    border-radius: 12px;
    padding: 5px 12px;
    font-weight: 600;
}

QPushButton#sortResetButton:hover {
    background: #303746;
}

QPushButton#sortCloseButton {
    background: #222836;
    color: #d7dfec;
    border: 1px solid #596579;
    border-radius: 15px;
    padding: 0;
    font-weight: 700;
}

QPushButton#sortCloseButton:hover {
    background: #313a4c;
    color: #ffffff;
}

QScrollArea#sortCriteriaScroll {
    background: #171a21;
    border: none;
}

QScrollArea#sortCriteriaScroll > QWidget > QWidget {
    background: #171a21;
}

QWidget#sortCriteriaStack {
    background: #171a21;
}

QWidget#sortCriteriaCard {
    background: #252b36;
    border: 1px solid #3c4554;
    border-radius: 8px;
}

QWidget#sortCriteriaCard:hover {
    border-color: #5d6c83;
    background: #2d333e;
}

QWidget#sortCriteriaCard[dragging="true"] {
    border-color: #72a7ff;
    background: #303b4e;
}

QWidget#sortCriteriaCard[inactive="true"] {
    background: #20252e;
    border-color: #333c4b;
}

QLabel#sortDragHandle {
    color: #7f8998;
    font-size: 11px;
    font-weight: 700;
}

QLabel#sortRankCircle {
    color: #ffffff;
    background: #3a4658;
    border: 1px solid #68758a;
    border-radius: 13px;
    font-size: 12px;
    font-weight: 700;
}

QLabel#sortCriterionTitle {
    color: #ffffff;
    font-size: 13px;
    font-weight: 700;
}

QLabel#sortCriterionDescription {
    color: #adb7c5;
    font-size: 11px;
}

QPushButton#sortArrowButton {
    background: #1f2430;
    color: #d6dde8;
    border: 1px solid #465166;
    border-radius: 5px;
    padding: 0;
    font-weight: 700;
}

QPushButton#sortArrowButton:hover {
    background: #2b3342;
    color: #ffffff;
}

QPushButton#sortArrowButton:disabled {
    color: #667181;
    background: #1b2029;
    border-color: #313947;
}

QPlainTextEdit {
    background: #25272d;
    color: #f1f3f5;
    border: 1px solid #4b505b;
    font-family: Consolas, "Courier New", monospace;
    selection-background-color: #3d5f93;
    selection-color: #ffffff;
}

QPushButton {
    background: #30333a;
    color: #f1f3f5;
    border: 1px solid #626875;
    border-radius: 4px;
    padding: 6px 10px;
}

QPushButton:hover {
    background: #3a3e47;
}

QPushButton:pressed {
    background: #25272d;
}

QPushButton#primaryButton {
    font-weight: 600;
    background: #3b78e7;
    color: #ffffff;
    border-color: #3b78e7;
}

QPushButton#primaryButton:hover {
    background: #4f8cff;
    border-color: #4f8cff;
}

QPushButton#load_button,
QPushButton#browseButton,
QPushButton#compactButton {
    font-weight: 500;
}

QPushButton#compactButton {
    min-width: 96px;
    padding: 5px 8px;
}

QPushButton#load_button {
    background: #26344f;
    color: #d8e6ff;
    border-color: #5b82ba;
}

QPushButton#load_button:hover {
    background: #304260;
}

QPushButton#modeButton {
    background: #30333a;
    color: #f1f3f5;
    border: 1px solid #626875;
    border-radius: 4px;
    font-weight: 500;
    padding: 6px 10px;
}

QPushButton#modeButton:hover {
    background: #3a3e47;
}

QPushButton#modeButton:checked {
    background: #3b78e7;
    color: #ffffff;
    border-color: #3b78e7;
}

QPushButton#modeButton:checked:hover {
    background: #4f8cff;
    border-color: #4f8cff;
}

QPushButton#pageRulerButton,
QPushButton#pageRulerButtonActive {
    background: transparent;
    border: none;
    color: #8fd8ff;
    font-weight: 600;
    padding: 4px 6px;
}

QPushButton#pageRulerButton:hover {
    color: #ffffff;
    background: #2b415c;
}

QPushButton#pageRulerButtonActive {
    color: #ffffff;
    border-bottom: 2px solid #8fd8ff;
}

QLabel#pageRulerEllipsis {
    color: #8f98a8;
    font-weight: 600;
    padding: 4px 2px;
}

QPushButton:disabled,
QLineEdit:disabled,
QComboBox:disabled,
QDateEdit:disabled {
    color: #8b929d;
    background: #292b31;
    border-color: #454a54;
}

QSplitter::handle {
    background: #4b505b;
}

QWidget#topNavigation {
    background: #202838;
    border-bottom: 1px solid #33445e;
    min-height: 58px;
    max-height: 58px;
}

QLabel#navBackLabel {
    color: #7ed3ff;
    font-size: 24px;
    font-weight: 600;
}

QLabel#navTitleLabel {
    color: #7ed3ff;
    font-size: 18px;
    font-weight: 700;
    padding-right: 24px;
}

QPushButton#navTab,
QPushButton#navTabActive {
    min-width: 88px;
    min-height: 58px;
    border-radius: 0;
    border: none;
    background: transparent;
    color: #9faabc;
    font-weight: 600;
}

QPushButton#navTab:hover {
    background: #273247;
    color: #dce8f7;
}

QPushButton#navTab:disabled {
    background: transparent;
    color: #717b8d;
}

QPushButton#navTabActive {
    background: #2b415c;
    color: #7ed3ff;
    border-bottom: 2px solid #7ed3ff;
}

QFrame#toastNotification {
    background: #24324b;
    border: 1px solid #5d83bd;
    border-radius: 18px;
}

QLabel#toastMessage {
    background: transparent;
    color: #ffffff;
    font-size: 15px;
    font-weight: 500;
}

QPushButton#toastCloseButton {
    background: transparent;
    color: #dcecff;
    border: none;
    border-radius: 11px;
    font-size: 12px;
    font-weight: 700;
    padding: 0;
}

QPushButton#toastCloseButton:hover {
    background: #334763;
    color: #ffffff;
}

QWidget#cardPanel {
    background: #252b38;
    border: 1px solid #495467;
    border-radius: 6px;
}

QWidget#cardPanel QWidget {
    background: transparent;
}

QWidget#cardPanel QLabel#sectionTitle,
QWidget#cardPanel QLabel#sectionTitleLabel {
    font-size: 16px;
}

QScrollArea#inputPanelScrollArea {
    background: #1f2024;
    border: none;
}

QScrollArea#inputPanelScrollArea > QWidget > QWidget {
    background: #1f2024;
}

QWidget#calendarView,
QWidget#calendarContent {
    background: #1f2024;
}

QLabel#calendarStatusLabel,
QLabel#calendarLegendLabel {
    color: #c6ccd5;
}

QWidget#calendarInstructionPanel {
    color: #d7e8ff;
    background: #26344f;
    border: 1px solid #496896;
    border-radius: 4px;
}

QLabel#calendarInstructionLabel {
    color: #d7e8ff;
    background: transparent;
    border: none;
    padding: 0;
}

QLabel#calendarInstructionIcon {
    color: #26344f;
    background: #d7e8ff;
    border: 1px solid #9fc2ef;
    border-radius: 4px;
    font-weight: 700;
}

QLabel#calendarPlaceholderLabel {
    color: #dcecff;
    background: #24324b;
    border: 1px solid #4d6f9f;
    border-radius: 14px;
    padding: 14px 22px;
    font-size: 13px;
    font-weight: 500;
}

QWidget#calendarPeriodSection {
    background: transparent;
    border: none;
}

QWidget#calendarMonthGrid {
    background: #252b38;
    border: 1px solid #495467;
    border-radius: 6px;
}

QLabel#calendarPeriodHeader {
    background: #2b415c;
    color: #7ed3ff;
    border: 1px solid #49627f;
    border-radius: 6px;
    padding: 9px 12px;
    font-size: 14px;
    font-weight: 700;
}

QFrame#calendarDivider {
    color: #394456;
    background: #394456;
}

QScrollArea#calendarScroll {
    background: #1f2024;
    border: none;
}

QScrollArea#calendarScroll > QWidget > QWidget {
    background: #1f2024;
}

QScrollBar:vertical,
QScrollBar:horizontal {
    background: #1f2024;
    border: none;
}

QScrollBar::handle:vertical,
QScrollBar::handle:horizontal {
    background: #5c626d;
    border-radius: 4px;
}

QScrollBar::handle:vertical:hover,
QScrollBar::handle:horizontal:hover {
    background: #737b89;
}

QFrame#homeImagePanel {
    background: transparent;
    margin-top: 6px;
}

QWidget#constraintRow {
    background: transparent;
}

QLabel#constraintTitle {
    background: transparent;
    font-size: 14px;
    font-weight: 600;
    color: #f1f3f5;
}

QLabel#constraintDescription {
    background: transparent;
    font-size: 12px;
    color: #c6ccd5;
}

QLabel#constraintKLabel {
    background: transparent;
    font-size: 11px;
    font-weight: 600;
    color: #d7dce2;
}

QLineEdit#constraintKInput:disabled {
    color: #8b929d;
    background: #292b31;
    border-color: #454a54;
}

QLineEdit#constraintKInput[invalid="true"] {
    border: 1px solid #c9605a;
}

QLabel#constraintError {
    background: transparent;
    color: #ff9d97;
    font-size: 11px;
    font-weight: 500;
}

QWidget#constraintDivider {
    background: #394456;
}

QCheckBox#constraintToggle::indicator {
    width: 18px;
    height: 18px;
    border-radius: 4px;
    border: 1px solid #5c626d;
    background: #2b2d33;
}

QCheckBox#constraintToggle::indicator:hover {
    border-color: #72a7ff;
}

QCheckBox#constraintToggle::indicator:checked {
    background: #3b78e7;
    border-color: #3b78e7;
}

QCheckBox#constraintToggle::indicator:disabled {
    background: #292b31;
    border-color: #454a54;
}

QLabel#constraintSaveStatus {
    background: transparent;
    font-size: 12px;
    font-weight: 500;
    padding: 6px 0;
}

QLabel#constraintSaveStatus[state="success"] {
    color: #7ed3ff;
}

QLabel#constraintSaveStatus[state="error"] {
    color: #ff9d97;
}

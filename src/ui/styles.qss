QMainWindow {
    background: #f7f8fa;
}

QWidget {
    color: #202124;
    font-size: 13px;
}

QLabel#screenTitle {
    font-size: 22px;
    font-weight: 600;
    color: #202124;
}

QLabel#sectionTitle {
    font-size: 14px;
    font-weight: 600;
    color: #3c4043;
}

QLabel {
    color: #202124;
}

QLabel#error_label,
QLabel#programSelectionMessage {
    color: #174ea6;
    background: #eef4ff;
    border: 1px solid #c6dafc;
    border-radius: 4px;
    padding: 8px 10px;
}

QLabel#paneTitle {
    font-weight: 600;
    color: #3c4043;
}

QLabel#programSelectionCount {
    font-weight: 600;
    color: #3c4043;
}

QLineEdit,
QComboBox {
    background: #ffffff;
    color: #202124;
    border: 1px solid #aeb4bb;
    border-radius: 3px;
    padding: 5px 8px;
    selection-background-color: #2f6fed;
    selection-color: #ffffff;
}

QLineEdit:focus,
QComboBox:focus {
    border-color: #2f6fed;
}

QListWidget#programSelector {
    background: #ffffff;
    color: #202124;
    border: 1px solid #c8cdd3;
    border-radius: 4px;
    padding: 8px;
}

QListWidget#programSelector::item {
    color: #202124;
    padding: 7px 8px;
}

QListWidget#programSelector::item:hover {
    background: #f3f6fb;
}

QListWidget#programSelector::indicator {
    width: 16px;
    height: 16px;
}

QPlainTextEdit {
    background: #ffffff;
    color: #202124;
    border: 1px solid #c8cdd3;
    font-family: Consolas, "Courier New", monospace;
}

QPushButton {
    background: #ffffff;
    color: #202124;
    border: 1px solid #aeb4bb;
    border-radius: 4px;
    padding: 6px 10px;
}

QPushButton:hover {
    background: #eef2f7;
}

QPushButton#primaryButton {
    font-weight: 600;
    background: #2f6fed;
    color: #ffffff;
    border-color: #2f6fed;
}

QPushButton#primaryButton:hover {
    background: #2563d8;
    border-color: #2563d8;
}

QPushButton#load_button,
QPushButton#browseButton {
    font-weight: 500;
}

QPushButton#load_button {
    background: #ffffff;
    color: #174ea6;
    border-color: #9bbcf9;
}

QPushButton#load_button:hover {
    background: #eef4ff;
}

QPushButton#modeButton {
    background: #f7f9fc;
    color: #202124;
    border: 1px solid #aeb4bb;
    border-radius: 4px;
    font-weight: 500;
    padding: 6px 10px;
}

QPushButton#modeButton:hover {
    background: #e4e9f2;
}

QPushButton#modeButton:checked {
    background: #2f6fed;
    color: #ffffff;
    border-color: #2f6fed;
}

QPushButton#modeButton:checked:hover {
    background: #2563d8;
    border-color: #2563d8;
}

QPushButton:disabled,
QLineEdit:disabled,
QComboBox:disabled {
    color: #6f7782;
    background: #eef1f4;
}

QSplitter::handle {
    background: #c8cdd3;
}
